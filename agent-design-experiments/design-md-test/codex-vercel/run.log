   PUBLIC STYLESHEET — bounded, documented vocabulary of classes and tokens.
   Real values, extracted verbatim from this blog's actual published CSS.

   Build pages using ONLY these class names and tokens. Do not invent new
   colors, fonts, radii, or spacing values — if something you need isn't
   documented here, use the closest documented primitive rather than adding
   a new one. This is the Vercel-style split: this file is downloaded and
   linked in the browser, not pasted into your own <style> block, so it
   never has to sit in your context window while you write.
   ========================================================================== */

:root {
  --bg: #f5f6f9;
  --surface: #ffffff;
  --ink: #161a22;
  --ink-soft: #525a6e;
  --ink-faint: #8a91a3;
  --line: #e1e4ea;
  --line-strong: #c7cbd6;
  --accent: #2f5fed;
  --accent-ink: #1c3fb0;
  --accent-soft: #e9eefd;
  --ok: #1f8a5f;
  --ok-soft: #e3f3ec;
  --warn: #a06a12;
  --warn-soft: #f7edd9;
  --crit: #c23b3b;
  --crit-soft: #fbe6e6;
  --alt: #7c3aed;
  --alt-ink: #5b21b6;
  --alt-soft: #f3ecfd;
  --code-bg: #edf0f5;
  --grid-dot: rgba(22, 26, 34, 0.05);
  --shadow: 0 1px 2px rgba(22,26,34,0.04), 0 8px 24px rgba(22,26,34,0.05);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #10131a; --surface: #171c26; --ink: #e8eaf1; --ink-soft: #a7aec2; --ink-faint: #6d7590;
    --line: #262c3a; --line-strong: #363e50; --accent: #7d9dff; --accent-ink: #b9caff; --accent-soft: #1c2740;
    --ok: #3ecb90; --ok-soft: #123326; --warn: #d9a441; --warn-soft: #2c2417; --crit: #e5726f; --crit-soft: #341918;
    --alt: #b794f6; --alt-ink: #d6c2fb; --alt-soft: #241b38;
    --code-bg: #1b202b; --grid-dot: rgba(232, 234, 241, 0.045); --shadow: 0 1px 2px rgba(0,0,0,0.3), 0 8px 24px rgba(0,0,0,0.35);
  }
}

* { box-sizing: border-box; }

body {
