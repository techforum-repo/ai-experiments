.disclaimer { max-width: 680px; margin: 22px 0 0; padding: 14px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: 0.86rem; font-style: italic; color: var(--ink-faint); line-height: 1.6; }

