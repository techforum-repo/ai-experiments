<rect x=\"384\" y=\"85\" width=\"244\" height=\"28\" rx=\"3\" fill=\"#275d45\"/><text x=\"506\" y=\"103\" text-anchor=\"middle\" style=\"fill:#f5f3eb;font-size:11px\">Commit payment + saved receipt</text>
