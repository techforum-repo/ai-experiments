import re
class Check(HTMLParser):
    def __init__(self):
        super().__init__(); self.words=[]; self.skip=False
    def handle_starttag(self, tag, attrs):
        assert tag "'!= '"'style'
        assert not any(k == 'style' for k,v in attrs)
        if tag == 'head': self.skip=True
    def handle_endtag(self, tag):
        if tag == 'head': self.skip=False
    def handle_data(self, data):
        if not self.skip: self.words.extend(data.split())
