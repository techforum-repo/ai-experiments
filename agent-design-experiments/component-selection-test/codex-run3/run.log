    def __init__(self): super().__init__(); self.parts=[]
    def handle_data(self, data): self.parts.append(data)
p=Text(); p.feed(s)
print('Visible word count:', len(' '.join(p.parts).split()))
for name, old, new in [('badge','label-text','cleanup-due')]:
    snippet=Path(f'components/{name}.html').read_text().split('\\n',1)[1].strip().replace(old,new)
    assert snippet in s
for name in ['banner','callout','steps']:
    template=Path(f'components/{name}.html').read_text()
    structure=lambda x: re.findall(r'</?["'^!][''^>]*>'"',x)
    tag='ol' if name=='steps' else 'div'
    block=re.search(fr'<{tag} class=\"{name}\">.*?</{tag}>',s,re.S).group()
    assert structure(template)==structure(block),name
assert '<style' not in s and ' style=' not in s
assert '<link rel=\"stylesheet\" href=\"stylesheet.css\">' in s
print('Component structures and stylesheet constraints verified.')
