/* Fictive Docs — house stylesheet. Build only with these classes. */

:root {
  --bg: #fafaf9;
  --surface: #ffffff;
  --ink: #1c1917;
  --ink-soft: #57534e;
  --ink-faint: #a8a29e;
  --line: #e7e5e4;
  --accent: #0f766e;
  --accent-ink: #115e59;
  --accent-soft: #ecfdf5;
  --warn: #b45309;
  --warn-soft: #fffbeb;
  --crit: #b91c1c;
  --crit-soft: #fef2f2;
  --code-bg: #f5f5f4;
  --radius: 8px;
  --shadow: 0 1px 2px rgba(28,25,23,.04), 0 6px 16px rgba(28,25,23,.05);
}

body { margin: 0; background: var(--bg); color: var(--ink); font-family: "Inter", ui-sans-serif, system-ui, sans-serif; font-size: 17px; line-height: 1.65; }
.page { max-width: 760px; margin: 0 auto; padding: 48px 24px 96px; }
.prose { max-width: 680px; }
h1 { font-size: 2.1rem; line-height: 1.15; margin: 0 0 12px; }
h2 { font-size: 1.4rem; margin: 2em 0 0.6em; }
h3 { font-size: 1.1rem; margin: 1.6em 0 0.5em; }
p { margin: 0 0 1em; }
code { background: var(--code-bg); padding: 0.1em 0.4em; border-radius: 4px; font-family: ui-monospace, monospace; font-size: 0.9em; }
pre { background: var(--code-bg); border-radius: var(--radius); padding: 16px 18px; overflow-x: auto; }
a { color: var(--accent-ink); }

/* --- Drawing-attention family: callout / note / banner --- */
/* All three are documented and production-ready. The spec does not say which to use when. */

.callout {
  border-left: 3px solid var(--accent);
  background: var(--accent-soft);
  border-radius: var(--radius);
  padding: 14px 18px;
  margin: 1.4em 0;
}
.callout.warn { border-left-color: var(--warn); background: var(--warn-soft); }
.callout.crit { border-left-color: var(--crit); background: var(--crit-soft); }

.note {
  display: inline-block;
  background: var(--code-bg);
  border: 1px solid var(--line);
  border-radius: 6px;
  padding: 2px 8px;
  font-size: 0.88em;
  color: var(--ink-soft);
}

.banner {
  background: var(--ink);
  color: var(--surface);
  border-radius: var(--radius);
  padding: 16px 20px;
  margin: 1.6em 0;
  font-size: 0.95em;
}
.banner.warn { background: var(--warn); }
.banner.crit { background: var(--crit); }

/* --- Status/label family: badge / tag / pill --- */
/* All three are documented and production-ready. The spec does not say which to use when. */

.badge {
  display: inline-block;
  background: var(--accent);
  color: #fff;
  border-radius: 4px;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 2px 8px;
}

.tag {
  display: inline-block;
  border: 1px solid var(--line);
  border-radius: 4px;
  font-size: 0.78rem;
  color: var(--ink-soft);
  padding: 2px 8px;
}

.pill {
  display: inline-block;
  background: var(--accent-soft);
  color: var(--accent-ink);
  border-radius: 100px;
  font-size: 0.78rem;
  font-weight: 600;
  padding: 3px 10px;
}

/* --- Sequence family: .steps / <ol> / <ul> --- */
/* All three are documented and production-ready. The spec does not say which to use when. */

.steps { list-style: none; counter-reset: step; padding: 0; margin: 1.4em 0; }
.steps li { counter-increment: step; position: relative; padding: 4px 0 4px 40px; margin-bottom: 10px; }
.steps li::before {
  content: counter(step, decimal-leading-zero);
  position: absolute; left: 0; top: 2px;
  font-family: ui-monospace, monospace;
  font-size: 0.8rem;
  color: var(--accent-ink);
  background: var(--accent-soft);
  border-radius: 4px;
  width: 26px; height: 22px;
  display: flex; align-items: center; justify-content: center;
}

ol, ul { padding-left: 1.4em; margin: 1.2em 0; }
li { margin-bottom: 0.4em; }

