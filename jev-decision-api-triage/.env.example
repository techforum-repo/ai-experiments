# Copy to .env and add your keys. .env is git-ignored.
# Required: TypeSafe Jev (console.typesafe.ai).
TYPESAFE_API_KEY=
# Optional: adds the OpenAI Decisions API to the comparison.
OPENAI_API_KEY=
# Optional: pin versions instead of the moving aliases, so reruns are comparable.
# JEV_MODEL=jev-1.14.0
# OPENAI_DECISIONS_MODEL=gpt-6-luna
