# Copy to .env and add your key. .env is git-ignored.
# Required: a Gemini API key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# Optional: pacing. Defaults match the free tier (200 requests and 50,000 tokens per minute).
# Tier 1 is 1500 / 1000000. Set to 0 to turn pacing off.
# GEMINI_RPM=200
# GEMINI_TPM=50000
# Optional: model and price overrides.
# GEMINI_DECISIONS_MODEL=gemini-decision-1
# GEMINI_DECISIONS_PRICE_PER_M=0.10
